# Local dev (from `supabase start`): use the ANON_KEY / API_URL it prints.
# Production: use your hosted Supabase project's URL + anon key (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — powers screenshot scanning on the log screen (Claude Haiku 4.5 vision).
# Get one at https://console.anthropic.com/settings/keys. Leave empty to disable
# scanning; manual entry still works without it.
ANTHROPIC_API_KEY=
